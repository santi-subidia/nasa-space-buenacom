# Copiar a .env (que está en .gitignore) y completar. NUNCA commitear la clave.
# Poner además un límite de gasto en la Console de Anthropic.
ANTHROPIC_API_KEY=

# 1 = no llamar nunca a la API y responder solo con lo guardado (demo pública, #21)
IA_APAGADA=0

