# Copiar a .env.local (que NO se sube al repo) y completar.
# Clave de la API de Anthropic para Claude Haiku 5.5 (solo se usa en el servidor, rutas app/api/**).
ANTHROPIC_API_KEY=

# Entrenador (MediaPipe Pose). Opcional: URL del modelo .task; por defecto el CDN de Google.
# Para trabajar sin conexion: bajar pose_landmarker_lite.task a public/mediapipe/ y poner /mediapipe/pose_landmarker_lite.task
NEXT_PUBLIC_POSE_MODEL_URL=
